# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://forge:forge@localhost:5432/forge"

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth (shared between web and api) ───────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# ─── OAuth: GitHub (https://github.com/settings/developers) ──
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ─── OAuth: Google (https://console.cloud.google.com) ────────
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── URLs ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3101"
WEB_URL="http://localhost:3100"
API_PORT="3101"
